+/*
+ * DSP signal (dspsignal) support, forward-ported from the unmerged 2024
+ * series "[PATCH v1 14/16] misc: fastrpc: Add DSP signal support"
+ * (Ekansh Gupta / Anandu Krishnan E, Qualcomm). EXPERIMENTAL.
+ */
+#define FASTRPC_DSPSIGNAL_TIMEOUT_NONE	0xffffffff
+#define FASTRPC_DSPSIGNAL_NUM_SIGNALS	1024
+#define FASTRPC_DSPSIGNAL_GROUP_SIZE	256
+#define FASTRPC_DSPSIGNAL_NUM_GROUPS	(FASTRPC_DSPSIGNAL_NUM_SIGNALS / FASTRPC_DSPSIGNAL_GROUP_SIZE)
+
+enum fastrpc_dspsignal_state {
+	DSPSIGNAL_STATE_UNUSED = 0,
+	DSPSIGNAL_STATE_PENDING,
+	DSPSIGNAL_STATE_SIGNALED,
+	DSPSIGNAL_STATE_CANCELED,
+};
+
+struct fastrpc_dspsignal {
+	struct completion comp;
+	int state;
+};
+
