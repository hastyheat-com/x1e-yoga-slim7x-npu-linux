+static struct fastrpc_dspsignal *fastrpc_dspsignal_get(struct fastrpc_user *fl, u32 signal_id)
+{
+	struct fastrpc_dspsignal *group = fl->signal_groups[signal_id / FASTRPC_DSPSIGNAL_GROUP_SIZE];
+
+	return group ? &group[signal_id % FASTRPC_DSPSIGNAL_GROUP_SIZE] : NULL;
+}
+
+static int fastrpc_dspsignal_signal(struct fastrpc_user *fl, u32 signal_id)
+{
+	struct fastrpc_channel_ctx *cctx = fl->cctx;
+	u64 msg;
+
+	if (!cctx->rpdev)
+		return -EPIPE;
+	/* The DSP knows this process by the client_id sent at PD creation */
+	msg = ((u64)(u32)fl->client_id << 32) | signal_id;
+	return rpmsg_send(cctx->rpdev->ept, &msg, sizeof(msg));
+}
+
+static int fastrpc_dspsignal_wait(struct fastrpc_user *fl, u32 signal_id, u32 timeout_usec)
+{
+	struct fastrpc_dspsignal *s;
+	unsigned long irq_flags;
+	long ret;
+	int err = 0;
+
+	spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+	s = fastrpc_dspsignal_get(fl, signal_id);
+	if (!s || s->state == DSPSIGNAL_STATE_UNUSED) {
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+		return -ENOENT;
+	}
+	if (s->state != DSPSIGNAL_STATE_PENDING) {
+		if (s->state == DSPSIGNAL_STATE_CANCELED)
+			err = -EINTR;
+		else /* SIGNALED: consume it */
+			s->state = DSPSIGNAL_STATE_PENDING;
+		if (!err)
+			reinit_completion(&s->comp);
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+		return err;
+	}
+	spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+
+	if (timeout_usec != FASTRPC_DSPSIGNAL_TIMEOUT_NONE)
+		ret = wait_for_completion_interruptible_timeout(&s->comp,
+				usecs_to_jiffies(timeout_usec));
+	else
+		ret = wait_for_completion_interruptible(&s->comp);
+
+	if (ret == 0)
+		return -ETIMEDOUT;
+	if (ret < 0)
+		return ret;
+
+	spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+	if (s->state == DSPSIGNAL_STATE_SIGNALED) {
+		s->state = DSPSIGNAL_STATE_PENDING;
+		reinit_completion(&s->comp);
+	} else if (s->state == DSPSIGNAL_STATE_CANCELED ||
+		   s->state == DSPSIGNAL_STATE_UNUSED) {
+		err = -EINTR;
+	}
+	spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+
+	return err;
+}
+
+static int fastrpc_dspsignal_create(struct fastrpc_user *fl, u32 signal_id)
+{
+	struct fastrpc_dspsignal *group, *sig;
+	unsigned long irq_flags;
+	int i, gi = signal_id / FASTRPC_DSPSIGNAL_GROUP_SIZE;
+
+	mutex_lock(&fl->signal_create_mutex);
+	if (!fl->signal_groups[gi]) {
+		group = kcalloc(FASTRPC_DSPSIGNAL_GROUP_SIZE, sizeof(*group), GFP_KERNEL);
+		if (!group) {
+			mutex_unlock(&fl->signal_create_mutex);
+			return -ENOMEM;
+		}
+		for (i = 0; i < FASTRPC_DSPSIGNAL_GROUP_SIZE; i++) {
+			init_completion(&group[i].comp);
+			group[i].state = DSPSIGNAL_STATE_UNUSED;
+		}
+		spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+		fl->signal_groups[gi] = group;
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+	}
+
+	spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+	sig = fastrpc_dspsignal_get(fl, signal_id);
+	if (sig->state != DSPSIGNAL_STATE_UNUSED) {
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+		mutex_unlock(&fl->signal_create_mutex);
+		return -EBUSY;
+	}
+	sig->state = DSPSIGNAL_STATE_PENDING;
+	reinit_completion(&sig->comp);
+	spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+	mutex_unlock(&fl->signal_create_mutex);
+
+	return 0;
+}
+
+static int fastrpc_dspsignal_end(struct fastrpc_user *fl, u32 signal_id, int new_state)
+{
+	struct fastrpc_dspsignal *s;
+	unsigned long irq_flags;
+
+	spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+	s = fastrpc_dspsignal_get(fl, signal_id);
+	if (!s || s->state == DSPSIGNAL_STATE_UNUSED) {
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+		return -ENOENT;
+	}
+	if (s->state != new_state) {
+		s->state = new_state;
+		complete_all(&s->comp);
+	}
+	spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+
+	return 0;
+}
+
+static int fastrpc_invoke_dspsignal(struct fastrpc_user *fl, char __user *argp)
+{
+	struct fastrpc_ioctl_dspsignal sig;
+
+	if (copy_from_user(&sig, argp, sizeof(sig)))
+		return -EFAULT;
+	if (sig.req == FASTRPC_DSPSIGNAL_QUERY)
+		return 0;
+	if (sig.signal_id >= FASTRPC_DSPSIGNAL_NUM_SIGNALS)
+		return -EINVAL;
+
+	switch (sig.req) {
+	case FASTRPC_DSPSIGNAL_SIGNAL:
+		return fastrpc_dspsignal_signal(fl, sig.signal_id);
+	case FASTRPC_DSPSIGNAL_WAIT:
+		return fastrpc_dspsignal_wait(fl, sig.signal_id, sig.timeout_usec);
+	case FASTRPC_DSPSIGNAL_CREATE:
+		if (sig.timeout_usec) /* flags must be 0 */
+			return -EINVAL;
+		return fastrpc_dspsignal_create(fl, sig.signal_id);
+	case FASTRPC_DSPSIGNAL_DESTROY:
+		return fastrpc_dspsignal_end(fl, sig.signal_id, DSPSIGNAL_STATE_UNUSED);
+	case FASTRPC_DSPSIGNAL_CANCEL_WAIT:
+		return fastrpc_dspsignal_end(fl, sig.signal_id, DSPSIGNAL_STATE_CANCELED);
+	}
+	return -EINVAL;
+}
+
+/* Called from the rpmsg callback (atomic context) */
+static void fastrpc_handle_signal_rpmsg(u64 msg, struct fastrpc_channel_ctx *cctx)
+{
+	u32 client_id = msg >> 32;
+	u32 signal_id = msg & 0xffffffff;
+	struct fastrpc_dspsignal *sig;
+	struct fastrpc_user *fl;
+	unsigned long flags, irq_flags;
+	bool found = false;
+
+	if (signal_id >= FASTRPC_DSPSIGNAL_NUM_SIGNALS)
+		return;
+
+	spin_lock_irqsave(&cctx->lock, flags);
+	list_for_each_entry(fl, &cctx->users, user) {
+		if ((u32)fl->client_id != client_id)
+			continue;
+		found = true;
+		spin_lock_irqsave(&fl->dspsignals_lock, irq_flags);
+		sig = fastrpc_dspsignal_get(fl, signal_id);
+		if (sig && (sig->state == DSPSIGNAL_STATE_PENDING ||
+			    sig->state == DSPSIGNAL_STATE_SIGNALED)) {
+			sig->state = DSPSIGNAL_STATE_SIGNALED;
+			complete(&sig->comp);
+		} else {
+			dev_dbg(&cctx->rpdev->dev, "unknown signal %u for client %u\n",
+				signal_id, client_id);
+		}
+		spin_unlock_irqrestore(&fl->dspsignals_lock, irq_flags);
+		break;
+	}
+	spin_unlock_irqrestore(&cctx->lock, flags);
+	if (!found)
+		dev_dbg(&cctx->rpdev->dev, "signal %u for unknown client %u\n",
+			signal_id, client_id);
+}
